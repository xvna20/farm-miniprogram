.page{min-height:100vh;background:#F6F1E7;color:#373A35}.top{height:54px;background:#FDFBF6;display:flex;justify-content:space-between;align-items:center;padding:0 18px;box-sizing:border-box}.title{font-size:17px;font-weight:700}.scroll{height:calc(100vh - 54px - var(--status-bar-height, 44px))}.hero{margin:16px;padding:24px 18px 20px;background:#8F9670;border-radius:22px;color:#F6F1E7}.hero-tag{display:block;font-size:12px;line-height:16px}.hero-title{display:block;margin-top:15px;margin-bottom:4px;font-size:24px;font-weight:700;line-height:32px}.hero-sub{display:block;font-size:12px;line-height:16px}.section-title{display:block;margin:0 18px 16px;font-size:19px;font-weight:700}.route{display:flex;gap:14px;margin:0 20px 20px}.dot{background:#C49A52;color:white;width:28px;height:28px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:11px;font-weight:700;}.route-name{font-size:13px;font-weight:500;}.source{margin:20px 18px;padding:23px 18px 75px;background:#FDFBF6;border-radius:12px;box-shadow:0 2px 8px rgba(79,69,51,.08);}.source-item{display:block;font-size:12px;line-height:18px;}.source-item+.source-item{margin-top:3px;}
