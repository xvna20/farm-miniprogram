.page {
  min-height: 100vh;
  background-color: #F6F1E7;
  padding-bottom: 60rpx;
}

/* 导航栏 */
.nav-status {
  background-color: #F6F1E7;
}

.nav-bar {
  height: 104rpx;
  background-color: #FDFBF6;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.nav-back {
  position: absolute;
  left: 32rpx;
  font-size: 52rpx;
  color: #373A35;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #373A35;
}

/* 英雄横幅 */
.hero {
  margin: 24rpx 32rpx;
  background-color: #B8893F;
  border-radius: 42rpx;
  padding: 42rpx 40rpx 62rpx;
  display: flex;
  flex-direction: column;
}

.hero-tag {
  font-size: 25rpx;
  color: #8E3B32;
  margin-bottom: 38rpx;
}

.hero-title {
  font-size: 50rpx;
  font-weight: bold;
  color: #8E3B32;
  line-height: 1.3;
}

/* 简介 */
.desc {
  padding: 42rpx 32rpx 0;
  font-size: 28rpx;
  color: #373A35;
  line-height: 1.7;
}

/* 时间轴 */
.timeline {
  padding: 94rpx 32rpx 0;
}

.timeline-item {
  position: relative;
  height: 165rpx;
  margin-bottom: 20rpx;
}

.badge {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 92rpx;
  height: 92rpx;
  background-color: #8E3B32;
  border-radius: 31rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: bold;
  color: #fff;
  z-index: 1;
}

.line {
  position: absolute;
  left: 45rpx;
  top: calc(50% + 50rpx);
  width: 2rpx;
  height: 104rpx;
  background-color: #8E3B32;
  opacity: 0.45;
}

.card {
  margin-left: 65rpx;
  height: 165rpx;
  background-color: #FDFBF6;
  border-radius: 24rpx;
  padding: 0 28rpx 0 46rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #8E3B32;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #74766F;
  line-height: 1.5;
}

/* 引言 */
.quote {
  margin: 40rpx 32rpx 0;
  background-color: #E8D8B7;
  border-radius: 24rpx;
  padding: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quote-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #8E3B32;
}
