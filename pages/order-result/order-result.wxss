page {
  min-height: 100%;
  background-color: #f7f1e7;
  color: #30312d;
}

.page {
  min-height: 100vh;

  padding: 110rpx 54rpx 80rpx;

  box-sizing: border-box;

  display: flex;
  flex-direction: column;
  align-items: center;
}


/* =========================
   成功图标
   ========================= */

.success-icon {
  width: 110rpx;
  height: 110rpx;

  border-radius: 50%;

  background-color: #e2e8d7;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #88966d;

  font-size: 68rpx;
  font-weight: 400;

  line-height: 1;
}


/* =========================
   成功文字
   ========================= */

.success-title {
  margin-top: 46rpx;

  font-size: 38rpx;
  font-weight: 700;

  color: #30312d;
}

.success-subtitle {
  margin-top: 12rpx;

  font-size: 24rpx;

  color: #88847a;
}


/* =========================
   订单信息卡片
   ========================= */

.order-card {
  width: 100%;

  margin-top: 48rpx;

  padding: 30rpx 34rpx;

  box-sizing: border-box;

  border-radius: 22rpx;

  background-color: #fffdf8;

  box-shadow:
    0 6rpx 18rpx
    rgba(70, 58, 35, 0.05);
}

.info-row {
  min-height: 56rpx;

  display: flex;
  align-items: center;
  justify-content: space-between;
}

.info-label {
  flex-shrink: 0;

  margin-right: 20rpx;

  font-size: 23rpx;

  color: #77736b;
}

.info-value {
  flex: 1;

  text-align: right;

  font-size: 23rpx;
  font-weight: 600;

  color: #3f3e38;
}

.order-number {
  word-break: break-all;
}

.amount {
  font-size: 30rpx;
  font-weight: 700;

  color: #30312d;
}

.delivery-tip {
  margin-top: 14rpx;

  padding-top: 20rpx;

  border-top: 1rpx solid rgba(80, 70, 50, 0.08);

  font-size: 22rpx;
  line-height: 1.6;

  color: #8d887e;
}


/* =========================
   模拟订单提示
   ========================= */

.demo-tip {
  margin-top: 26rpx;

  font-size: 20rpx;
  line-height: 1.6;

  text-align: center;

  color: #aaa59b;
}


/* =========================
   按钮
   ========================= */

.button-area {
  width: 100%;

  margin-top: 54rpx;
}

.primary-button {
  width: 100%;
  height: 76rpx;

  border-radius: 16rpx;

  background-color: #cd9c3e;

  color: #ffffff;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 26rpx;
  font-weight: 600;
}

.secondary-button {
  width: 100%;
  height: 76rpx;

  margin-top: 20rpx;

  box-sizing: border-box;

  border: 2rpx solid #c79a45;
  border-radius: 16rpx;

  background-color: #fffdf8;

  color: #a97e35;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 26rpx;
  font-weight: 600;
}