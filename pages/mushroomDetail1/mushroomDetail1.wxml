<view class="page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;">
    
    
  </view>
  <view class="topbar">
    <view class="back-hit" bindtap="goBack"><text class="back-icon">‹</text></view>
    <text class="topbar-title">本地菌种辨识</text>
    
  </view>

  <view class="content">
    <text class="page-title">品种特征与辨识方法</text>
    <text class="page-subtitle">点击菌种名称，切换查看对应资料</text>

    <view class="tabs">
      <view class="tab tab-active">月下香菇</view>
      <view class="tab tab-inactive" bindtap="goDetail2">怀远秀珍菇</view>
    </view>

    <view class="species-hero">
      <image class="species-hero-bg" src="/images/yuexia-shiitake.jpg" mode="aspectFill"/>
      <view class="species-hero-mask"/>
      <text class="species-tag">【机场新村】绿色大棚·月下香菇</text>
      <text class="species-title">月下香菇</text>
    </view>

    <view class="info-card feature-card">
      <text class="info-title">品种特征</text>
      <rich-text class="info-desc" nodes="{{featureText}}"/>
    </view>

    <view class="info-card nutrition-card">
      <text class="info-title">营养价值</text>
      <rich-text class="info-desc" nodes="{{nutritionText}}"/>
    </view>

    <view class="info-card identify-card">
      <text class="info-title">辨识方法</text>
      <rich-text class="info-desc" nodes="{{identifyText}}"/>
    </view>
  </view>
</view>
