.page {
  min-height: 100vh;
  background: #f5f1e7;
}
.content {
  padding: 24rpx 28rpx 60rpx;
}
.doc-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
}
.doc-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C2416;
  text-align: center;
  margin-bottom: 12rpx;
}
.doc-date {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 40rpx;
}
.doc-section {
  margin-bottom: 32rpx;
}
.doc-heading {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2416;
  margin-bottom: 12rpx;
}
.doc-text {
  font-size: 26rpx;
  color: #6B5D4F;
  line-height: 1.8;
  margin-bottom: 8rpx;
}
