<view class="page">

<!-- 收货地址 -->
<view
  class="card address-card"
  bindtap="chooseAddress"
>

  <view class="section-title">
    收货地址
  </view>

  <view class="address-main">

    <view
      wx:if="{{address}}"
      class="address-content"
    >

      <view class="receiver-line">
        <text class="receiver-name">
          {{address.name}}
        </text>

        <text class="receiver-phone">
          {{address.phoneDisplay}}
        </text>
      </view>

      <view class="address-detail">
        {{address.detail}}
      </view>

    </view>

    <view
      wx:else
      class="address-content address-empty"
    >
      请选择收货地址
    </view>

    <view class="arrow">
      ›
    </view>

  </view>

</view>


<!-- 商品 -->
<view class="card">

  <view class="store-name">
    皖北珍菌助农商城
  </view>

  <view
    class="order-item"
    wx:for="{{orderItems}}"
    wx:key="productId"
  >

    <view class="product-image">

      <image
        wx:if="{{item.image}}"
        class="real-image"
        src="{{item.image}}"
        mode="aspectFill"
      />

      <text
        wx:else
        class="image-text"
      >
        {{item.imageText}}
      </text>

    </view>


    <view class="product-info">

      <view class="product-name">
        {{item.name}}
      </view>

      <view class="product-subtitle">
        {{item.shortSubtitle}}
      </view>

      <view class="product-quantity">
        × {{item.quantity}}
      </view>

    </view>


    <view class="product-subtotal">
      ¥ {{item.subtotalText}}
    </view>

  </view>

</view>


<!-- 配送 -->
<view class="card">

  <view class="card-row">

    <view>
      <view class="row-title">
        配送方式
      </view>

      <view class="row-description">
        {{deliveryText}}
      </view>
    </view>

    <view class="row-right">

      <view class="gold-text">
        {{deliveryType}}
      </view>

      <view class="freight-text">
        运费 ¥ {{freight}}
      </view>

    </view>

  </view>

</view>


<!-- 支付 -->
<view class="card">

  <view class="card-row">

    <view>
      <view class="row-title">
        支付方式
      </view>

      <view class="row-description">
        实践展示，不产生真实支付
      </view>
    </view>

    <view class="gold-text">
      模拟支付
    </view>

  </view>

</view>


<!-- 底部结算 -->
<view class="bottom-area">

  <view class="amount-area">

    <view class="amount-row">
      <text>商品金额</text>
      <text>¥ {{goodsAmount}}</text>
    </view>

    <view class="amount-row">
      <text>运费</text>
      <text>¥ {{freight}}</text>
    </view>

    <view class="total-row">
      <text>合计</text>
      <text class="total-price">
        ¥ {{totalAmount}}
      </text>
    </view>

  </view>

  <view
    class="submit-button"
    bindtap="submitOrder"
  >
    提交订单
  </view>

</view>

</view>