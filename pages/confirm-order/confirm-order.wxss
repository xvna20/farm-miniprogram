page {
  min-height: 100%;
  background-color: #f7f1e7;
  color: #30312d;
}

.page {
  min-height: 100vh;

  box-sizing: border-box;

  padding:
    26rpx
    28rpx
    calc(250rpx + env(safe-area-inset-bottom));
}


/* 卡片 */

.card {
  margin-bottom: 22rpx;

  padding: 26rpx;

  box-sizing: border-box;

  background-color: #fffdf8;

  border-radius: 22rpx;

  box-shadow:
    0 5rpx 16rpx
    rgba(70, 58, 35, 0.05);
}


/* 地址 */

.section-title {
  margin-bottom: 18rpx;

  font-size: 25rpx;
  font-weight: 700;
}

.address-main {
  display: flex;
  align-items: center;
}

.address-content {
  flex: 1;
}

.receiver-line {
  display: flex;
  align-items: center;

  margin-bottom: 10rpx;
}

.receiver-name {
  margin-right: 20rpx;

  font-size: 28rpx;
  font-weight: 700;
}

.receiver-phone {
  font-size: 26rpx;
  font-weight: 600;
}

.address-detail {
  font-size: 23rpx;
  color: #8c887f;
}

.arrow {
  margin-left: 20rpx;

  font-size: 38rpx;
  color: #75726a;
}


/* 商城 */

.store-name {
  margin-bottom: 24rpx;

  font-size: 28rpx;
  font-weight: 700;
}


/* 商品 */

.order-item {
  position: relative;

  display: flex;
  align-items: center;

  margin-top: 22rpx;
}

.product-image {
  flex-shrink: 0;

  width: 100rpx;
  height: 100rpx;

  overflow: hidden;

  border-radius: 14rpx;

  background-color: #e8e1d4;

  display: flex;
  align-items: center;
  justify-content: center;
}

.real-image {
  width: 100%;
  height: 100%;
}

.image-text {
  font-size: 21rpx;
  color: #908873;
}

.product-info {
  flex: 1;

  min-width: 0;

  margin-left: 20rpx;
}

.product-name {
  font-size: 26rpx;
  font-weight: 700;
}

.product-subtitle {
  margin-top: 6rpx;

  font-size: 21rpx;
  color: #99958d;
}

.product-quantity {
  margin-top: 7rpx;

  font-size: 22rpx;
  color: #77736a;
}

.product-subtotal {
  margin-left: 15rpx;

  font-size: 25rpx;

  color: #b98938;

  font-weight: 600;
}


/* 配送、支付 */

.card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.row-title {
  font-size: 27rpx;
  font-weight: 700;
}

.row-description {
  margin-top: 10rpx;

  font-size: 21rpx;
  color: #9a968d;
}

.row-right {
  text-align: right;
}

.gold-text {
  font-size: 24rpx;

  color: #b88a3c;
}

.freight-text {
  margin-top: 9rpx;

  font-size: 21rpx;
  color: #77736a;
}


/* 底部 */

.bottom-area {
  position: fixed;

  left: 0;
  right: 0;
  bottom: 0;

  z-index: 100;

  padding:
    20rpx
    30rpx
    calc(18rpx + env(safe-area-inset-bottom));

  box-sizing: border-box;

  background-color: #fffdf8;

  border-top:
    1rpx solid
    rgba(90, 80, 60, 0.08);
}

.amount-area {
  margin-bottom: 18rpx;
}

.amount-row,
.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;

  margin-bottom: 7rpx;

  font-size: 22rpx;
  color: #77736b;
}

.total-row {
  margin-top: 10rpx;

  color: #4a463e;

  font-size: 25rpx;
}

.total-price {
  font-size: 34rpx;

  font-weight: 700;

  color: #bb8b38;
}

.submit-button {
  height: 76rpx;

  border-radius: 16rpx;

  background-color: #cf9e3e;

  color: #ffffff;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 27rpx;
  font-weight: 700;
}