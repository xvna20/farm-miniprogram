page {
  background-color: #f7f1e7;
  color: #30312d;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 170rpx;
}


/* =========================
   商品列表
   ========================= */

.cart-list {
  padding: 28rpx 30rpx;
}

.cart-card {
  position: relative;

  display: flex;
  align-items: center;

  padding: 24rpx;

  margin-bottom: 22rpx;

  background-color: #fffdf8;

  border-radius: 22rpx;

  box-shadow: 0 6rpx 18rpx rgba(70, 58, 35, 0.05);
}


/* =========================
   勾选按钮
   ========================= */

.check-button {
  flex-shrink: 0;

  width: 42rpx;
  height: 42rpx;

  border: 2rpx solid #ba9857;

  border-radius: 50%;

  margin-right: 20rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  box-sizing: border-box;

  color: #ffffff;

  font-size: 24rpx;
}

.check-button.checked {
  background-color: #c79a45;
  border-color: #c79a45;
}


/* =========================
   商品图片
   ========================= */

.product-image {
  flex-shrink: 0;

  width: 170rpx;
  height: 130rpx;

  border-radius: 16rpx;

  overflow: hidden;

  background-color: #e8e1d4;

  display: flex;
  align-items: center;
  justify-content: center;
}

.real-image {
  width: 100%;
  height: 100%;
}

.image-text {
  font-size: 25rpx;
  color: #8d856f;
}


/* =========================
   商品信息
   ========================= */

.product-info {
  flex: 1;

  min-width: 0;

  margin-left: 22rpx;
}

.product-name {
  font-size: 29rpx;
  font-weight: 700;

  margin-bottom: 8rpx;
}

.product-subtitle {
  font-size: 22rpx;
  color: #969188;

  margin-bottom: 10rpx;
}

.product-price {
  font-size: 25rpx;
  color: #bd8d3b;

  font-weight: 600;
}


/* =========================
   数量控制
   ========================= */

.quantity-box {
  margin-top: 16rpx;

  width: 170rpx;
  height: 50rpx;

  display: flex;
  align-items: center;

  background-color: #f5efe4;

  border-radius: 26rpx;

  overflow: hidden;
}

.quantity-button {
  width: 54rpx;
  height: 50rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 28rpx;

  color: #625a4b;
}

.quantity-number {
  flex: 1;

  text-align: center;

  font-size: 24rpx;
}


/* =========================
   删除按钮
   ========================= */

.delete-button {
  position: absolute;

  right: 24rpx;
  bottom: 28rpx;

  font-size: 22rpx;

  color: #5e5c55;
}


/* =========================
   底部结算栏
   ========================= */

.settlement-bar {
  position: fixed;

  left: 0;
  right: 0;
  bottom: 0;

  min-height: 146rpx;

  padding: 18rpx 28rpx 24rpx;

  box-sizing: border-box;

  background-color: #fffdf8;

  border-top: 1rpx solid rgba(90, 80, 60, 0.08);

  display: flex;
  align-items: center;
}

.select-area {
  display: flex;
  align-items: center;

  flex-shrink: 0;
}

.select-area .check-button {
  margin-right: 12rpx;
}

.select-all-text {
  font-size: 24rpx;
}

.settlement-info {
  flex: 1;

  margin-left: 24rpx;
}

.selected-count {
  font-size: 20rpx;
  color: #99948a;

  margin-bottom: 6rpx;
}

.total-area {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 23rpx;

  margin-right: 10rpx;

  color: #7f786c;
}

.total-price {
  font-size: 33rpx;

  color: #bd8d3b;

  font-weight: 700;
}

.checkout-button {
  flex-shrink: 0;

  width: 190rpx;
  height: 74rpx;

  border-radius: 16rpx;

  background-color: #c79a45;

  color: #ffffff;

  font-size: 26rpx;
  font-weight: 600;

  display: flex;
  align-items: center;
  justify-content: center;
}


/* =========================
   空购物车
   ========================= */

.empty-cart {
  min-height: 76vh;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 0 40rpx;
}

.empty-bag {
  font-size: 100rpx;

  opacity: 0.28;

  margin-bottom: 28rpx;
}

.empty-title {
  font-size: 32rpx;

  font-weight: 700;

  margin-bottom: 14rpx;
}

.empty-description {
  font-size: 24rpx;

  color: #969188;

  margin-bottom: 44rpx;
}

.go-mall-button {
  width: 360rpx;
  height: 72rpx;

  border-radius: 18rpx;

  background-color: #c79a45;

  color: #ffffff;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 25rpx;
  font-weight: 600;
}