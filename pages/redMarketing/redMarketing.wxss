.page{min-height:100vh;background:#f6f1e7;color:#373a35}.status{background:#f6f1e7}.top{height:108rpx;background:#fdfbf6;display:flex;align-items:center;justify-content:center;position:relative;font-size:34rpx;font-weight:700}.back{position:absolute;left:28rpx;top:6rpx;font-size:58rpx;font-weight:400}.dots{position:absolute;right:28rpx;top:24rpx;font-size:28rpx;letter-spacing:8rpx}.scroll{height:calc(100vh - 108rpx)}.content{width:700rpx;margin:0 auto;padding:28rpx 0 40rpx}.hero{height:244rpx;color:#8e3b32}.eyebrow{display:block;font-size:30rpx;line-height:46rpx}.title{display:block;font-size:84rpx;line-height:88rpx;font-weight:700;margin-top:12rpx}.sub{display:block;font-size:30rpx;line-height:46rpx;margin-top:8rpx}.image{height:338.46rpx;border:2rpx solid #8e3b32;border-radius:30.77rpx;overflow:hidden;position:relative;margin-bottom:84.62rpx}.image image{width:100%;height:100%}.image .tint{position:absolute;inset:0;background:rgba(142,59,50,.16);pointer-events:none}.caption{position:absolute;left:0;right:0;bottom:0;height:123.08rpx;background:rgba(142,59,50,.82);color:#fdfbf6;padding:19.23rpx 30.77rpx;font-size:25rpx;line-height:40.38rpx;box-sizing:border-box}.caption text{display:block}.caption text.source{font-size:20.19rpx;line-height:32.69rpx}.section-title{display:block;font-size:36rpx;font-weight:700;margin:0 4rpx 26rpx}.point{min-height:144rpx;background:#fdfbf6;border:2rpx solid #e5ded1;border-radius:28rpx;margin-bottom:20rpx;padding:22rpx 30rpx;box-sizing:border-box;position:relative}.accent{position:absolute;left:-2rpx;top:22rpx;width:8rpx;bottom:22rpx;background:#8e3b32;border-radius:4rpx}.pt{display:block;color:#8e3b32;font-size:28rpx;line-height:42rpx;font-weight:700}.pd{display:block;font-size:25rpx;line-height:40rpx}.return{height:96rpx;border-radius:28rpx;background:#e8d8b7;color:#8e3b32;text-align:center;line-height:96rpx;font-size:26rpx;margin-top:32rpx}
