<view class="page">

  <!-- 顶部 Header -->
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-back" bindtap="onGoBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="header-title">意见反馈</view>
  </view>
  <view class="spacer" style="height: {{statusBarHeight + 44}}px;"></view>

  <view class="content">

    <!-- 主视觉区：欢迎卡片 -->
    <view class="welcome-card">
      <view class="welcome-title">您的建议，会让乡村服务更好</view>
      <view class="welcome-subtitle">请告诉我们遇到的问题或希望改进的地方</view>
    </view>

    <!-- 反馈类型选择 -->
    <view class="section">
      <view class="section-title">请选择反馈类型</view>
      <view class="type-list">
        <view
          wx:for="{{typeList}}"
          wx:key="key"
          class="type-item {{form.type === item.key ? 'type-item-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onTypeSelect"
        >{{item.label}}</view>
      </view>
    </view>

    <!-- 描述文本框 -->
    <view class="section">
      <view class="section-title">请详细描述</view>
      <view class="textarea-wrap">
        <textarea
          class="feedback-textarea"
          placeholder="请描述您遇到的问题、出现位置和期望改进方式……"
          placeholder-class="input-placeholder"
          value="{{form.content}}"
          bindinput="onContentInput"
          maxlength="300"
        ></textarea>
        <view class="word-count">{{contentLength}} / 300</view>
      </view>
    </view>

    <!-- 联系方式 -->
    <view class="section">
      <view class="contact-label">联系方式（选填）</view>
      <view class="contact-wrap">
        <input
          class="contact-input"
          type="text"
          placeholder="请输入手机号或微信号，方便我们联系您"
          placeholder-class="input-placeholder"
          value="{{form.contact}}"
          bindinput="onContactInput"
          maxlength="50"
        />
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-btn" bindtap="onSubmit">提交反馈</view>

  </view>
</view>
