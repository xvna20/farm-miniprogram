/* ================= 页面基础 ================= */
.page {
  min-height: 100vh;
  background: #F5F0E8;
}

/* ================= 顶部标题栏（使用 app.wxss 全局 .nav-status / .nav-bar 系） ================= */

/* ================= 内容区 ================= */
.content {
  padding: 0 28rpx 60rpx;
}

/* ================= 表单卡片 ================= */
.form-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 8rpx 0;
  margin-top: 24rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 32rpx 32rpx;
  border-bottom: 2rpx solid #F0E8DC;
}

.form-row:last-child {
  border-bottom: none;
}

.form-row-clickable {
  background: transparent;
}

.form-row-column {
  flex-direction: column;
  align-items: stretch;
}

.form-label {
  font-size: 28rpx;
  color: #2C2416;
  width: 180rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.form-label-top {
  width: 100%;
  margin-bottom: 16rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #2C2416;
  text-align: right;
  min-width: 0;
}

.form-value-wrap {
  flex: 1;
  text-align: right;
  min-width: 0;
  padding-right: 8rpx;
}

.form-value {
  font-size: 28rpx;
  color: #2C2416;
}

.form-placeholder {
  font-size: 28rpx;
  color: #A89B8C;
}

.form-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #2C2416;
  line-height: 1.6;
  padding: 4rpx 0;
}

.input-placeholder {
  color: #A89B8C;
}

.region-picker {
  display: block;
}

.form-arrow {
  font-size: 32rpx;
  color: #D5C8B8;
  flex-shrink: 0;
  margin-left: 8rpx;
}

/* ================= 定位入口 ================= */
.locate-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  margin-bottom: 28rpx;
}

.locate-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.locate-text {
  flex: 1;
  font-size: 28rpx;
  color: #8B6914;
  font-weight: 500;
}

/* ================= 默认地址开关 ================= */
.switch-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 48rpx;
}

.switch-label {
  font-size: 28rpx;
  color: #2C2416;
  font-weight: 500;
}

/* ================= 按钮 ================= */
.save-btn {
  background: linear-gradient(135deg, #B8860B 0%, #8B6914 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  line-height: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(184, 134, 11, 0.3);
}

.delete-btn {
  background: #FFFFFF;
  color: #C0392B;
  font-size: 28rpx;
  text-align: center;
  line-height: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  border: 2rpx solid #F0D8D4;
}