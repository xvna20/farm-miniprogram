<view class="page">

  <!-- 顶部 Header -->
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-back" bindtap="onGoBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="header-title">我的订单</view>
    <view class="header-menu">
      <text class="menu-icon">⋯</text>
    </view>
  </view>
  <view class="spacer" style="height: {{statusBarHeight + 44}}px;"></view>

  <view class="order-section-title">订单状态</view>

  <!-- Tab 切换栏 -->
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{currentTab === item.key ? 'tab-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTabChange"
    >{{item.label}}</view>
  </view>

  <view class="content">

    <!-- 订单列表（有数据时） -->
    <view wx:if="{{orderList.length > 0}}" class="order-list">
      <view wx:for="{{orderList}}" wx:key="orderNumber" class="order-card" bindtap="onOrderTap" data-order="{{item.orderNumber}}">
        <view class="order-card-head">
          <text class="order-number">单号 {{item.orderNumber}}</text>
          <text class="order-status {{item.status}}">{{item.statusLabel}}</text>
        </view>

        <view class="order-card-body">
          <view class="order-good" wx:for="{{item.items}}" wx:for-item="g" wx:key="productId">
            <image class="good-img" src="{{g.image}}" mode="aspectFill"></image>
            <view class="good-info">
              <view class="good-name">{{g.name}}</view>
              <view class="good-sub">{{g.shortSubtitle}}</view>
            </view>
            <view class="good-right">
              <text class="good-price">¥{{g.priceText}}/{{g.unit}}</text>
              <text class="good-num">x{{g.quantity}}</text>
            </view>
          </view>
        </view>

        <view class="order-card-foot">
          <text class="foot-time">下单时间 {{item.timeText}}</text>
          <view class="foot-total">共{{item.itemCount}}件 · 实付 <text class="total-yen">¥{{item.totalAmount}}</text></view>
        </view>

        <!-- 待付款：继续付款入口 -->
        <view wx:if="{{item.status === 'unpaid'}}" class="pay-entry">点击继续付款 ›</view>
      </view>
    </view>

    <!-- 空状态（无数据时） -->
    <view wx:else class="empty-state">
      <view class="empty-circle">
        <text class="empty-char">{{currentTabInfo.emptyChar}}</text>
      </view>
      <view class="empty-title">{{currentTabInfo.emptyTitle}}</view>
      <view class="empty-sub">{{currentTabInfo.emptySub}}</view>
      <view class="empty-btn" bindtap="onGoMall">去商城看看</view>
    </view>

    <!-- 底部说明 -->
    <view class="footer-tip">订单状态更新后将自动同步</view>

  </view>
</view>
