/* ================= 页面基础 ================= */
.page {
  min-height: 100vh;
  background: #F5F0E8;
}

/* ================= 顶部 Header ================= */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  position: relative;
}

.header-back {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.back-icon {
  font-size: 56rpx;
  color: #2C2416;
  font-weight: 300;
}

.header-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #2C2416;
  line-height: 88rpx;
  height: 88rpx;
  pointer-events: none;
}

.spacer {
  width: 100%;
}

/* ================= 内容区 ================= */
.content {
  padding: 0 28rpx 60rpx;
}

/* ================= 头像卡片 ================= */
.avatar-card {
  display: flex;
  align-items: center;
  background: #8B9B6B;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  margin-top: -120rpx;
  margin-bottom: 30rpx;
}

.avatar-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 32rpx;
  color: #FFFFFF;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-info {
  flex: 1;
  margin-left: 32rpx;
}

.avatar-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.avatar-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

/* ================= 区块标题 ================= */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2416;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

/* ================= 表单卡片 ================= */
.form-card {
  display: flex;
  flex-direction: column;
  margin-bottom: 32rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  background: #FFFFFF;
  border: 2rpx solid #D5C8B8;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-picker {
  display: block;
  margin-bottom: 24rpx;
}

.form-picker .form-item {
  margin-bottom: 0;
}

.form-picker:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #2C2416;
  flex-shrink: 0;
  width: 160rpx;
}

.form-value {
  flex: 1;
  font-size: 28rpx;
  color: #2C2416;
  text-align: right;
  margin-right: 12rpx;
}

.form-arrow {
  font-size: 32rpx;
  color: #D5C8B8;
  flex-shrink: 0;
}

/* ================= 简介卡片 ================= */
.bio-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 20rpx;
  margin-bottom: 48rpx;
}

.bio-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #2C2416;
  line-height: 1.6;
}

.bio-placeholder {
  color: #A89B8C;
  font-size: 28rpx;
}

/* ================= 保存按钮 ================= */
.save-btn {
  background: linear-gradient(135deg, #B8860B 0%, #8B6914 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  line-height: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
}