/* ================= 页面基础 ================= */
.page {
  min-height: 100vh;
  background: #F5F0E8;
}

/* ================= 顶部 Header ================= */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: #FFFFFF;
}

.header-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #2C2416;
  line-height: 88rpx;
  height: 88rpx;
}

.spacer {
  width: 100%;
}

/* ================= 内容区 ================= */
.content {
  padding: 0 28rpx 40rpx;
}

/* ================= 用户卡片 ================= */
.user-card {
  display: flex;
  align-items: flex-start;
  background: #8B9B6B;
  border-radius: 32rpx;
  padding: 56rpx 44rpx;
  margin-top: 50rpx;
  margin-bottom: 28rpx;
}

.user-avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 34rpx;
  color: #FFFFFF;
}

.user-info {
  flex: 1;
  margin-left: 28rpx;
  min-width: 0;
}

.user-name {
  font-size: 38rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.4;
}

.user-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 10rpx;
}

.edit-btn {
  font-size: 26rpx;
  color: #FFFFFF;
  flex-shrink: 0;
  align-self: flex-end;
}

/* ================= 订单卡片 ================= */
.order-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx 28rpx;
  margin-bottom: 28rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.order-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2416;
}

.order-all {
  font-size: 24rpx;
  color: #A89B8C;
}

.order-stats {
  display: flex;
  justify-content: space-around;
}

.order-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.order-count {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #8B9B6B;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-label {
  font-size: 22rpx;
  color: #6B5D4F;
  margin-top: 12rpx;
}

/* ================= 功能列表 ================= */
.menu-card {
  display: flex;
  flex-direction: column;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 36rpx 28rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
}

.menu-item:last-child {
  margin-bottom: 0;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #8B9B6B;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-char {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.menu-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #2C2416;
}

.menu-desc {
  font-size: 24rpx;
  color: #A89B8C;
  margin-top: 6rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #D5C8B8;
  flex-shrink: 0;
}