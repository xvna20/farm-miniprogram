<view class="page">

  <!-- 顶部标题栏 -->
  <view class="nav-status" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-bar">
    <view class="nav-back" bindtap="onGoBack">‹</view>
    <text class="nav-title">关于项目</text>
  </view>

  <view class="content">

    <!-- 主视觉卡片 -->
    <view class="hero-card">
      <view class="hero-tag">2026 暑期『三下乡』</view>
      <view class="hero-title">寻访珠城发展足迹</view>
      <view class="hero-title">体悟科创红色乡兴</view>
      <view class="hero-subtitle">"智耘乡野"实践队</view>
    </view>

    <!-- 实践路线 -->
    <view class="section">
      <view class="section-title">实践路线</view>
      <view class="route-list">
        <view
          wx:for="{{routeList}}"
          wx:key="index"
          class="route-item"
        >
          <view class="badge badge-{{item.badgeType}}">{{index + 1}}</view>
          <view class="route-name">{{item.name}}</view>
        </view>
      </view>
    </view>

    <!-- 图片来源与替换说明 -->
    <view class="section">
      <view class="section-title">图片来源与替换说明</view>
      <view class="source-card">
        <view
          wx:for="{{sourceNotes}}"
          wx:key="index"
          class="source-item"
        >
          <view class="source-dot">·</view>
          <view class="source-text">{{item}}</view>
        </view>
      </view>
    </view>

    <!-- 协议与隐私 -->
    <view class="section">
      <view class="section-title">协议与隐私</view>
      <view class="source-card">
        <view class="source-item" bindtap="goToAgreement">
          <view class="source-dot">·</view>
          <view class="source-text source-link">用户服务协议</view>
        </view>
        <view class="source-item" bindtap="goToPrivacy">
          <view class="source-dot">·</view>
          <view class="source-text source-link">隐私政策</view>
        </view>
      </view>
    </view>

  </view>
</view>
