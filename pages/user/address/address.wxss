/* ================= 页面基础 ================= */
.page {
  min-height: 100vh;
  background: #F5F0E8;
}

/* ================= 顶部 Header ================= */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  position: relative;
}

.header-back {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.back-icon {
  font-size: 56rpx;
  color: #2C2416;
  font-weight: 300;
}

.header-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #2C2416;
  line-height: 88rpx;
  height: 88rpx;
  pointer-events: none;
}

.spacer {
  width: 100%;
}

/* ================= 内容区 ================= */
.content {
  padding: 0 28rpx 60rpx;
}

/* ================= 空状态 ================= */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0 80rpx;
  margin-top: -80rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #6B5D4F;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #A89B8C;
}

/* ================= 地址卡片 ================= */
.address-list {
  display: flex;
  flex-direction: column;
  margin-top: -110rpx;
}

.address-card {
  position: relative;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx 36rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: flex-start;
}

.default-tag {
  position: absolute;
  top: 24rpx;
  left: 36rpx;
  background: #D4C9A8;
  color: #6B5D4F;
  font-size: 22rpx;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}

.addr-main {
  flex: 1;
  min-width: 0;
  padding-top: 16rpx;
}

.addr-top {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.addr-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #2C2416;
  margin-right: 24rpx;
}

.addr-phone {
  font-size: 30rpx;
  color: #2C2416;
}

.addr-detail {
  font-size: 26rpx;
  color: #6B5D4F;
  line-height: 1.5;
}

.addr-edit {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #B8860B;
  font-weight: 500;
  padding-top: 16rpx;
  padding-left: 20rpx;
}

/* ================= 底部新增按钮 ================= */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 48rpx calc(40rpx + env(safe-area-inset-bottom));
  background: transparent;
}

.add-btn {
  background: linear-gradient(135deg, #B8860B 0%, #8B6914 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  line-height: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(184, 134, 11, 0.3);
}

.add-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
  font-weight: 400;
}

.add-text {
  font-size: 32rpx;
}