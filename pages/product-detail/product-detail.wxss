page {
  min-height: 100%;
  background-color: #f7f1e7;
  color: #30312d;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;

  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
}


/* =========================
   商品主图
   ========================= */

.product-cover {
  width: 100%;
  height: 560rpx;

  background-color: #e6e0d4;

  overflow: hidden;
}

.cover-image {
  display: block;

  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;

  display: flex;
  align-items: center;
  justify-content: center;

  background-color: #e6e0d4;
}

.cover-placeholder-text {
  font-size: 44rpx;
  font-weight: 700;

  color: #938b77;
}


/* =========================
   商品主体信息
   ========================= */

.product-main {
  padding: 34rpx 28rpx 40rpx;

  box-sizing: border-box;
}

.product-name {
  font-size: 40rpx;
  line-height: 1.35;

  font-weight: 700;

  color: #30312d;
}


/* 副标题 */

.product-subtitle {
  margin-top: 10rpx;

  font-size: 25rpx;
  line-height: 1.5;

  color: #918d83;
}


/* =========================
   价格
   ========================= */

.price-row {
  margin-top: 28rpx;

  display: flex;
  align-items: flex-end;

  height: 62rpx;
}

.product-price {
  font-size: 44rpx;
  line-height: 62rpx;

  font-weight: 700;

  color: #c2923d;
}

.product-unit {
  margin-left: 10rpx;
  margin-bottom: 5rpx;

  font-size: 25rpx;
  line-height: 34rpx;

  color: #847e72;
}


/* =========================
   商品标签
   ========================= */

.tag-list {
  margin-top: 26rpx;

  display: flex;
  align-items: center;
  flex-wrap: wrap;

  gap: 18rpx;
}

.tag {
  height: 54rpx;

  min-width: 138rpx;

  padding: 0 22rpx;

  box-sizing: border-box;

  border: 2rpx solid #c39a54;
  border-radius: 30rpx;

  background-color: #fffaf1;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #6f614a;

  font-size: 23rpx;
  line-height: 1;
}


/* =========================
   商品说明
   ========================= */

.description-card {
  margin-top: 30rpx;

  padding: 28rpx;

  box-sizing: border-box;

  border-radius: 22rpx;

  background-color: #fffdf8;

  box-shadow: 0 5rpx 16rpx rgba(70, 58, 35, 0.04);
}

.description-title {
  margin-bottom: 16rpx;

  font-size: 29rpx;
  line-height: 1.4;

  font-weight: 700;

  color: #34342f;
}

.description-text {
  font-size: 25rpx;
  line-height: 1.8;

  color: #77736b;
}


/* =========================
   底部操作栏
   ========================= */

.bottom-bar {
  position: fixed;

  left: 0;
  right: 0;
  bottom: 0;

  z-index: 100;

  min-height: 112rpx;

  padding:
    16rpx
    20rpx
    calc(16rpx + env(safe-area-inset-bottom));

  box-sizing: content-box;

  display: flex;
  align-items: center;

  gap: 18rpx;

  background-color: #fffdf8;

  border-top: 1rpx solid rgba(80, 70, 50, 0.08);
}


/* 购物车 */

.cart-entry {
  position: relative;

  width: 176rpx;
  height: 76rpx;

  flex-shrink: 0;

  border-radius: 40rpx;

  background-color: #ead9aa;

  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-entry-text {
  font-size: 25rpx;
  line-height: 1;

  color: #6f644e;
  transform: translateY(-6rpx);
}


/* 购物车数量 */

.cart-count {
  position: absolute;

  right: 2rpx;
  top: -12rpx;

  min-width: 36rpx;
  height: 36rpx;

  padding: 0 8rpx;

  box-sizing: border-box;

  border-radius: 20rpx;

  background-color: #b98736;

  color: #ffffff;

  font-size: 20rpx;
  line-height: 36rpx;

  text-align: center;
}


/* 加入购物车 */

.add-button {
  flex: 1;

  height: 76rpx;

  border-radius: 16rpx;

  background-color: #d0a03f;

  color: #ffffff;

  font-size: 28rpx;
  line-height: 76rpx;

  font-weight: 700;

  text-align: center;
}