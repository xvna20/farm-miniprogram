/* .page / .status-bar / .topbar / .back-hit / .back-icon / .topbar-title / .topbar-menu 已在 app.wxss 定义 */
.page { padding-bottom: 261.54rpx; }
.status-time, .status-signal { position: absolute; top: 14px; line-height: 1; }.status-time { left: 46.15rpx; }.status-signal { right: 36.54rpx; color: #373A35; font-size: 19.23rpx; }
.content { padding: 0 36.54rpx; }.page-title, .page-subtitle, .nutrition-title, .nutrition-line, .tip-title, .tip-desc { display: block; }.page-title { font-size: 46.15rpx; font-weight: 700; line-height: 65.38rpx; }.page-subtitle { font-size: 24.04rpx; line-height: 38.46rpx; color: #74766F; }
.capsules { position: relative; height: 142.31rpx; margin-top: 23.08rpx; }.capsule { position: absolute; top: 0; display: flex; box-sizing: border-box; width: 207.69rpx; height: 61.54rpx; align-items: center; justify-content: center; border-radius: 30.77rpx; background: #E4E7D6; color: #8F9670; font-size: 22.12rpx; font-weight: 500; }.capsule:nth-child(1) { left: 0; }.capsule:nth-child(2) { left: 232.69rpx; }.capsule:nth-child(3) { left: 465.38rpx; }.capsule.active { color: #FDFBF6; background: #8F9670; }.second-row-left { left: 115.38rpx; top: 73.08rpx; }.second-row-right { left: 348.08rpx; top: 73.08rpx; }
.image-wrap { position: relative; height: 403.85rpx; margin-top: 19.23rpx; overflow: hidden; border-radius: 34.62rpx; }.hero-image { width: 100%; height: 100%; }.image-caption { position: absolute; left: 26.92rpx; bottom: 23.08rpx; box-sizing: border-box; width: 330.77rpx; height: 46.15rpx; padding: 5.77rpx 15.38rpx; border-radius: 23.08rpx; background: rgba(253,251,246,.92); color: #74766F; font-size: 19.23rpx; line-height: 30.77rpx; }
.species-heading { display: flex; height: 65.38rpx; margin-top: 38.46rpx; align-items: center; justify-content: space-between; }.species-title { font-size: 46.15rpx; font-weight: 700; line-height: 65.38rpx; }.species-badge { display: flex; width: 215.38rpx; height: 53.85rpx; align-items: center; justify-content: center; border-radius: 26.92rpx; background: #E8D8B7; color: #8F9670; font-size: 21.15rpx; font-weight: 500; }
.nutrition-card { box-sizing: border-box; margin-top: 26.92rpx; padding: 28.85rpx 28.85rpx 42rpx; border: 1px solid #E5DED1; border-radius: 30.77rpx; background: #FDFBF6; }.nutrition-title { margin-bottom: 19.23rpx; color: #8F9670; font-size: 28.85rpx; font-weight: 700; line-height: 44.23rpx; }.nutrition-line { font-size: 25rpx; line-height: 42.31rpx; }
.common-tip { box-sizing: border-box; height: 176.92rpx; margin-top: 26.92rpx; padding: 26.92rpx 30.77rpx; overflow: hidden; border-radius: 30.77rpx; background: #E4E7D6; }.tip-title { color: #8F9670; font-size: 26.92rpx; font-weight: 700; line-height: 42.31rpx; }.tip-desc { margin-top: 11.54rpx; font-size: 23.08rpx; line-height: 36.54rpx; }.back-directory { display: flex; height: 88.46rpx; margin-top: 26.92rpx; align-items: center; justify-content: center; border-radius: 26.92rpx; background: #E8D8B7; color: #8F9670; font-size: 25rpx; font-weight: 500; }
.hero-image-king { display: block; width: 100%; margin-top: -40rpx; }
