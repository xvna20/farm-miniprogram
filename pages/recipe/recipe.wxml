<view class="page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="topbar"><view class="back-hit" bindtap="goBack"><text class="back-icon">‹</text></view><text class="topbar-title">食养安康</text></view>
  <view class="content">
    <text class="page-title">常见菌菇</text><text class="page-subtitle">点击菌菇名称，查看营养价值与养生功效</text>
    <view class="capsules">
      <view class="capsule {{active === 'shiitake' ? 'active' : ''}}" bindtap="selectSpecies" data-species="shiitake">香菇</view>
      <view class="capsule {{active === 'oyster' ? 'active' : ''}}" bindtap="selectSpecies" data-species="oyster">秀珍菇</view>
      <view class="capsule {{active === 'morel' ? 'active' : ''}}" bindtap="selectSpecies" data-species="morel">羊肚菌</view>
      <view class="capsule second-row-left {{active === 'enoki' ? 'active' : ''}}" bindtap="selectSpecies" data-species="enoki">金针菇</view>
      <view class="capsule second-row-right {{active === 'king' ? 'active' : ''}}" bindtap="selectSpecies" data-species="king">杏鲍菇</view>
    </view>
    <view class="image-wrap"><image class="hero-image {{active === 'king' ? 'hero-image-king' : ''}}" src="{{current.image}}" mode="{{active === 'king' ? 'widthFix' : 'aspectFill'}}" /><view class="image-caption">真实菌菇图片 · 网络素材</view></view>
    <view class="species-heading"><text class="species-title">{{current.title}}</text><text class="species-badge">{{current.base}}</text></view>
    <view class="nutrition-card {{active === 'oyster' ? 'nutrition-card-oyster' : ''}} {{active === 'morel' ? 'nutrition-card-morel' : ''}} {{active === 'enoki' ? 'nutrition-card-enoki' : ''}}"><text class="nutrition-title">营养价值与养生功效</text><text class="nutrition-line" wx:for="{{current.lines}}" wx:key="*this">• {{item}}</text></view>
    <view class="common-tip"><text class="tip-title">统一食用提示</text><text class="tip-desc">所有菌菇务必充分加热后食用，切忌凉拌生食；痛风急性发作期及菌类过敏人群应谨慎食用。</text></view>
    <view class="back-directory" bindtap="backToHealth">返回食养目录  ↑</view>
  </view>
</view>







