<view class="page">

<!-- 搜索区域 -->
<view class="search-box">
  <text class="search-icon">⌕</text>

  <input
    class="search-input"
    placeholder="搜索菌菇、食谱或产地"
    placeholder-class="search-placeholder"
    bindinput="onSearchInput"
  />
</view>


<!-- 助农宣传横幅 -->
<view class="hero-card">
  <view class="hero-small">
    机场新村 · 产地直发
  </view>

  <view class="hero-title">
    助农鲜菌季
  </view>

  <view class="hero-description">
    每一单都为村集体增收添力
  </view>
</view>


<!-- 商品分类 -->
<view class="category-list">

  <view
    wx:for="{{categories}}"
    wx:key="id"
    class="category-item {{activeCategory === item.id ? 'category-active' : ''}}"
    data-category="{{item.id}}"
    bindtap="selectCategory"
  >
    {{item.name}}
  </view>

</view>


<!-- 商品列表 -->
<view
  class="product-grid"
  wx:if="{{displayProducts.length > 0}}"
>

  <view
    class="product-card"
    wx:for="{{displayProducts}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="goToProductDetail"
  >

    <!-- 暂时使用文字占位，之后替换实拍图片 -->
    <view class="product-image">

      <image
        wx:if="{{item.image}}"
        class="real-product-image"
        src="{{item.image}}"
        mode="aspectFill"
      />

      <text
        wx:else
        class="product-image-text"
      >
        {{item.imageText}}
      </text>

    </view>

    <view class="product-info">

      <view class="product-name">
        {{item.name}}
      </view>

      <view class="product-subtitle">
        {{item.shortSubtitle}}
      </view>

      <view class="product-price">
        <text class="price-symbol">¥</text>
        <text class="price-number">{{item.price}}</text>
        <text class="price-unit"> / {{item.unit}}</text>
      </view>

    </view>

  </view>

</view>


<!-- 没有结果 -->
<view
  class="empty-result"
  wx:else
>
  <view class="empty-title">
    暂无相关商品
  </view>

  <view class="empty-description">
    换个关键词或分类试试吧
  </view>
</view>


<!-- 悬浮购物车 -->
<view
  class="cart-button"
  bindtap="goToCart"
>

  <text class="cart-icon">
    🛒
  </text>

  <view
    class="cart-badge"
    wx:if="{{cartCount > 0}}"
  >
    {{cartCount}}
  </view>

</view>

</view>