/* .page / .status-bar / .topbar / .back-hit / .back-icon / .topbar-title / .topbar-menu 已在 app.wxss 定义 */
.page { padding-bottom: 55.77rpx; }
.status-time, .status-signal { position: absolute; top: 14px; line-height: 1; }.status-time { left: 46.15rpx; }.status-signal { right: 36.54rpx; color: #373A35; font-size: 19.23rpx; }
.content { padding: 0 36.54rpx; }.hero-location, .hero-title, .hero-tags, .section-title, .step-title, .step-tag, .step-desc { display: block; }
.hero { box-sizing: border-box; height: 246.15rpx; margin-top: 40rpx; padding: 34.62rpx 38.46rpx; overflow: hidden; border-radius: 30.77rpx; background: #E4E7D6; }.hero-location { height: 38.46rpx; color: #74766F; font-size: 21.15rpx; font-weight: 500; line-height: 38.46rpx; }.hero-title { height: 38.46rpx; margin-top: 3.85rpx; font-size: 46.15rpx; font-weight: 700; line-height: 38.46rpx; white-space: nowrap; }.hero-tags { height: 38.46rpx; margin-top: 46.15rpx; color: #74766F; font-size: 23.08rpx; line-height: 38.46rpx; }
.section-row { position: relative; height: 38.46rpx; margin-top: 46.15rpx; }.section-title { font-size: 34.62rpx; font-weight: 700; line-height: 38.46rpx; }.revenue-hit { position: absolute; left: 334.62rpx; top: -19.23rpx; width: 353.85rpx; height: 76.92rpx; opacity: 0; }
.steps { margin-top: 30.77rpx; }.step-card { box-sizing: border-box; margin-bottom: 30.77rpx; padding: 32.69rpx; overflow: hidden; border: 1px solid #E5DED1; border-radius: 23.08rpx; background: #FDFBF6; }
.step-head { display: flex; align-items: center; height: 88.46rpx; }.step-head-long { height: 123.08rpx; }
.badge { position: relative; flex: none; width: 69.23rpx; height: 69.23rpx; }.badge-art { position: absolute; inset: 0; width: 69.23rpx; height: 69.23rpx; }.badge-number { position: absolute; left: 0; top: 15.38rpx; z-index: 1; width: 69.23rpx; color: #FDFBF6; font-size: 21.15rpx; font-weight: 700; line-height: 38.46rpx; text-align: center; }
.step-heading { flex: 1; min-width: 0; margin-left: 26.92rpx; }.step-title { font-size: 28.85rpx; font-weight: 700; line-height: 38.46rpx; }.step-tag { color: #8F9670; font-size: 21.15rpx; font-weight: 500; line-height: 38.46rpx; }.step-tag-long { margin-top: 3.85rpx; }
.step-arrow { flex: none; width: 46.15rpx; text-align: center; font-size: 28.85rpx; color: #8F9670; transform: rotate(0deg); transition: transform .3s ease; }
.step-arrow-open { transform: rotate(90deg); }
.step-body { max-height: 0; opacity: 0; overflow: hidden; transition: max-height .3s ease, opacity .3s ease; }
.step-card-open .step-body { max-height: 400rpx; opacity: 1; }
.step-desc { width: 100%; margin-top: 23.08rpx; color: #74766F; font-size: 21.15rpx; line-height: 34.62rpx; }.step-desc-compact { margin-top: 9.62rpx; }.step-desc-long { margin-top: -1.92rpx; }
