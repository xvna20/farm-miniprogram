<view class="page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="topbar">
    <view class="back-hit" bindtap="goBack"><text class="back-icon">‹</text></view>
    <text class="topbar-title">智慧菌仓流程</text>
    
  </view>

  <view class="content">
    <view class="hero">
      <text class="hero-location">怀远泽康基地</text>
      <text class="hero-title">智能化温控标准化种植模式</text>
      <text class="hero-tags">优选菌种 · 自动接种 · 智慧菌仓 · 冷链直供</text>
    </view>

    <view class="section-row">
      <text class="section-title">六步种植流程</text>
      <image class="revenue-hit" src="/images/smart-revenue-hit.svg" mode="fill" />
    </view>

    <view class="steps">
      <view class="step-card" wx:for="{{steps}}" wx:key="number">
        <view class="step-head {{item.longTitle ? 'step-head-long' : ''}}">
          <view class="badge"><image class="badge-art" src="/images/smart-step-badge.svg" mode="aspectFit" /><text class="badge-number">{{item.number}}</text></view>
          <view class="step-heading"><text class="step-title">{{item.title}}</text><text class="step-tag {{item.longTitle ? 'step-tag-long' : ''}}">{{item.tag}}</text></view>
        </view>
        <text class="step-desc {{item.compact ? 'step-desc-compact' : ''}} {{item.longTitle ? 'step-desc-long' : ''}}">{{item.desc}}</text>
      </view>
    </view>
  </view>
</view>
