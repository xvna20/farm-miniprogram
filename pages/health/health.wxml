<view class="page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="topbar"><view class="back-hit" bindtap="goBack"><text class="back-icon">‹</text></view><text class="topbar-title">食养安康</text></view>

  <view class="content">
    <view class="health-header"><text class="header-kicker">菌菇养生应用指南</text><text class="header-title">吃得明白，养得安心</text><text class="header-tags">营养 · 四季 · 储存 · 安全</text></view>
    <text class="section-title">食养目录</text>
    <view class="categories">
      <view class="category" bindtap="goRecipe"><view class="category-icon"><text>1</text></view><text class="category-label">常见菌菇</text></view>
      <view class="category" bindtap="goSeason"><view class="category-icon"><text>2</text></view><text class="category-label">四季吃法</text></view>
      <view class="category" bindtap="goSafety"><view class="category-icon"><text>3</text></view><text class="category-label">安全食用</text></view>
    </view>
    <image class="recipe-hero" src="/images/recipe-hero.jpg" mode="aspectFill" />
    <view class="safety" id="safety"><text class="safety-title">食用底线</text><text class="safety-desc">不采、不买、不食来源不明的野生菌；所有菌菇充分加热后再食用。</text></view>
  </view>
</view>


