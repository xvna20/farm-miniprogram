<view class="page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="topbar"><view class="back-hit" bindtap="goBack"><text class="back-icon">‹</text></view><text class="topbar-title">收益分配</text></view>

  <scroll-view class="scroll" scroll-y>
    <view class="header">
      <text class="header-title">菌菇售卖收益分配</text>
      <text class="header-sub">成本支出 · 村民薪资 · 发展再投入 · 公共积累</text>
    </view>

    <view class="pie-wrap">
      <view class="pie-container">
        <view class="sector sector-0 {{activeIndex === 0 ? 'sector-active' : ''}}"
              bindtap="selectSector" data-index="{{0}}"></view>
        <view class="sector sector-1 {{activeIndex === 1 ? 'sector-active' : ''}}"
              bindtap="selectSector" data-index="{{1}}"></view>
        <view class="sector sector-2 {{activeIndex === 2 ? 'sector-active' : ''}}"
              bindtap="selectSector" data-index="{{2}}"></view>
        <view class="sector sector-3 {{activeIndex === 3 ? 'sector-active' : ''}}"
              bindtap="selectSector" data-index="{{3}}"></view>

          <view class="labels">
            <text class="sector-label label-0">成本支出<text class="sector-pct">40%~50%</text></text>
            <text class="sector-label label-1">村民薪资<text class="sector-pct">30%~40%</text></text>
            <text class="sector-label label-2">发展再投入<text class="sector-pct">10%~15%</text></text>
            <view class="sector-label label-3">
              <text class="label-line">村集体</text>
              <text class="label-line">公共积累</text>
              <text class="label-line">5%~10%</text>
            </view>
          </view>
      </view>
    </view>

    <view class="detail-card">
        <text class="detail-title">{{sectors[activeIndex].title}}</text>
        <text class="detail-pct" style="color:{{sectors[activeIndex].color}}">{{sectors[activeIndex].percent}}</text>
        <text class="detail-sub">{{sectors[activeIndex].subTitle}}</text>
        <text class="detail-text">{{sectors[activeIndex].detail}}</text>
    </view>
  </scroll-view>
</view>
