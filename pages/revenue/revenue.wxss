page { background: #FCF8ED; }

/* ── topbar ── */
.topbar { position: relative; height: 104rpx; display: flex; align-items: center; justify-content: center; background: #8F9670; }
.back-hit { position: absolute; left: 0; top: 0; display: flex; width: 107.69rpx; height: 104rpx; align-items: center; }
.back-icon { margin-left: 32rpx; margin-top: 0; font-size: 52rpx; line-height: 1; color: #FDFBF6; }
.topbar-title { font-size: 34rpx; font-weight: bold; line-height: normal; color: #FDFBF6; }

/* ── scroll ── */
.scroll { height: calc(100vh - 142rpx); }

/* ── header ── */
.header { padding: 40rpx 40rpx 0; text-align: center; }
.header-title { display: block; font-size: 40rpx; font-weight: 700; color: #373A35; line-height: 56rpx; }
.header-sub { display: block; margin-top: 14rpx; font-size: 25rpx; color: #74766F; line-height: 40rpx; }

/* ════════════════════════════════════════
   饼图
   72% × 750rpx = 540rpx
   ════════════════════════════════════════ */
.pie-wrap { display: flex; justify-content: center; padding: 48rpx 0 0; }
.pie-container {
  position: relative;
  width: 540rpx;
  height: 540rpx;
}

/* ── 扇形板块 ── */
.sector {
  position: absolute;
  top: 0; left: 0;
  width: 540rpx;
  height: 540rpx;
  transition: transform .3s ease, opacity .3s ease;
  -webkit-tap-highlight-color: transparent;
}
.sector-label {
  position: absolute;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  text-align: center;
  pointer-events: none;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,.25);
  transform: translate(-50%, -50%);
  white-space: nowrap;
}
.sector-pct {
  display: block;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 32rpx;
  margin-top: 2rpx;
}

/* ════════════════════════════════════════
   clip-path 扇形
   每18°一个弧点，从顶部顺时针
   ════════════════════════════════════════ */

/* 0° → 162°  成本支出 45%  #839969 */
.sector-0 {
  clip-path: polygon(
    50% 50%,
    50% 0%, 65.45% 2.45%, 79.39% 9.55%, 90.45% 20.61%, 97.55% 34.55%,
    100% 50%, 97.55% 65.45%, 90.45% 79.39%, 79.39% 90.45%, 65.45% 97.55%
  );
  background: linear-gradient(135deg, #9BB07D 0%, #7A8F5E 100%);
}

/* 162° → 288°  村民薪资 35%  #B8860B */
.sector-1 {
  clip-path: polygon(
    50% 50%,
    65.45% 97.55%, 50% 100%, 34.55% 97.55%, 20.61% 90.45%, 9.55% 79.39%,
    2.45% 65.45%, 0% 50%, 2.45% 34.55%
  );
  background: linear-gradient(135deg, #C99A1E 0%, #A07808 100%);
}

/* 288° → 331.2°  发展再投入 12%  #A4B888 */
.sector-2 {
  clip-path: polygon(
    50% 50%,
    2.45% 34.55%, 9.55% 20.61%, 20.61% 9.55%, 25.91% 6.18%
  );
  background: linear-gradient(135deg, #B5C69C 0%, #8FA573 100%);
}

/* 331.2° → 360°  公共积累 8%  #D4B888 */
.sector-3 {
  clip-path: polygon(
    50% 50%,
    25.91% 6.18%, 34.55% 2.45%, 50% 0%
  );
  background: linear-gradient(135deg, #DFCA9F 0%, #C1A572 100%);
}

/* ── 标签覆盖层 ── */
.labels {
  position: absolute;
  left: 0; top: 0; width: 100%; height: 100%;
  z-index: 3;
  pointer-events: none;
}
/* ── 标签定位（各扇区视觉中心，约55%半径处） ── */
.label-0 { left: 77.2%; top: 45.7%; }
.label-1 { left: 30.6%; top: 69.5%; }
.label-2 { left: 28.8%; top: 32.5%; }
.label-3 { left: 42%; top: 5%; text-align: center; transform: translate(-50%, 0); }
.label-line { display: block; line-height: 30rpx; }

/* ════════════════════════════════════════
   交互状态
   ════════════════════════════════════════ */
.sector-active {
  transform: scale(1.06);
  z-index: 2;
  filter: brightness(1.15) drop-shadow(0 6rpx 20rpx rgba(0,0,0,.25));
}
/* ════════════════════════════════════════
   详情卡片
   ════════════════════════════════════════ */
.detail-card {
  width: 673rpx;
  margin: 36rpx auto 0;
  overflow: hidden;
  background: #FDFBF6;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(79,69,51,.08);
  padding: 30rpx 34rpx 28rpx;
  box-sizing: border-box;
  transition: opacity .25s ease;
}
.detail-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #373A35;
  line-height: 42rpx;
}
.detail-pct {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 56rpx;
  margin-top: 8rpx;
}
.detail-sub {
  display: block;
  font-size: 24rpx;
  color: #74766F;
  line-height: 36rpx;
  margin-top: 4rpx;
}
.detail-text {
  display: block;
  font-size: 24rpx;
  color: #74766F;
  line-height: 42rpx;
  margin-top: 18rpx;
  white-space: pre-line;
}
