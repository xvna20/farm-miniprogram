/* .page / .status-bar / .topbar / .back-hit / .back-icon / .topbar-title / .topbar-menu 已在 app.wxss 定义 */
.page { padding-bottom: 246.15rpx; }
.status-time, .status-signal { position: absolute; top: 14px; line-height: 1; }.status-time { left: 46.15rpx; }.status-signal { right: 36.54rpx; color: #373A35; font-size: 19.23rpx; }
.content { padding: 0 36.54rpx; }.hero-kicker, .hero-title, .hero-subtitle, .section-title, .card-title, .card-tag, .bullet { display: block; }
.hero { box-sizing: border-box; height: 246.15rpx; padding: 34.62rpx 38.46rpx; overflow: hidden; border-radius: 30.77rpx; background: #E4E7D6; }.hero-kicker { height: 38.46rpx; color: #74766F; font-size: 21.15rpx; font-weight: 500; line-height: 38.46rpx; }.hero-title { height: 38.46rpx; margin-top: 11.54rpx; font-size: 40.38rpx; font-weight: 700; line-height: 38.46rpx; }.hero-subtitle { margin-top: 34.62rpx; color: #74766F; font-size: 23.08rpx; line-height: 36.54rpx; }
.section-title { margin-top: 46.15rpx; font-size: 34.62rpx; font-weight: 700; line-height: 48.08rpx; }.cards { margin-top: 23.08rpx; }.revenue-card { box-sizing: border-box; height: 300rpx; margin-bottom: 30.77rpx; padding: 32.69rpx 32.69rpx 0; overflow: hidden; border: 1px solid #E5DED1; border-radius: 23.08rpx; background: #FDFBF6; }.card-head { display: flex; height: 88.46rpx; }.badge { position: relative; flex: none; width: 69.23rpx; height: 69.23rpx; }.badge-art { position: absolute; inset: 0; width: 69.23rpx; height: 69.23rpx; }.badge-number { position: absolute; left: 0; top: 16.35rpx; z-index: 1; width: 69.23rpx; color: #FDFBF6; font-size: 21.15rpx; font-weight: 700; line-height: 38.46rpx; text-align: center; }.heading { min-width: 0; margin-left: 26.92rpx; }.card-title { width: 519.23rpx; font-size: 28.85rpx; font-weight: 700; line-height: 38.46rpx; }.card-tag { width: 519.23rpx; color: #8F9670; font-size: 21.15rpx; font-weight: 500; line-height: 38.46rpx; }
.bullet-list { margin-top: 23.08rpx; }.bullet { width: 596.15rpx; color: #74766F; font-size: 21.15rpx; line-height: 34.62rpx; }
