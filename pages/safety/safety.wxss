page { background: #FCF8ED; }

/* ── scroll ── */
.scroll { height: calc(100vh - 141.85rpx); }

/* ── header ── */
.header { padding: 40rpx 40rpx 0; }
.header-title { display: block; font-size: 40rpx; font-weight: 700; color: #373A35; line-height: 56rpx; }
.header-sub { display: block; margin-top: 14rpx; font-size: 25rpx; color: #74766F; line-height: 42rpx; }

/* ════════════════════════════════════════
   安全卡片
   ════════════════════════════════════════ */
.safety-card {
  width: 673rpx;
  margin: 28rpx auto 0;
  box-sizing: border-box;
  padding: 36rpx 34rpx 32rpx;
  border-radius: 16rpx;
}
.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
  margin-bottom: 24rpx;
}
.danger-title { color: #C0392B; }
.green-title { color: #4A8C3F; }
.gold-title { color: #B8860B; }

/* ── 卡片① 毒菇鉴别 ── */
.card-danger { background: #FFF1F1; }

.card-rule {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}
.card-rule:last-child { margin-bottom: 0; }
.rule-icon { flex: none; width: 48rpx; font-size: 26rpx; line-height: 40rpx; }
.rule-body { flex: 1; min-width: 0; }
.rule-wrong {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #373A35;
  line-height: 38rpx;
}
.rule-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #74766F;
  line-height: 36rpx;
}

/* ── 卡片② 科学储存 ── */
.card-green { background: #F0F6E8; }

.card-section {
  margin-bottom: 20rpx;
}
.card-section:last-child { margin-bottom: 0; }
.section-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #373A35;
  line-height: 38rpx;
}
.section-text {
  display: block;
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #74766F;
  line-height: 36rpx;
}

/* ── 卡片③ 安全食用 ── */
.card-gold { background: #FFF7E6; }

.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.tip-item:last-child { margin-bottom: 0; }
.tip-dot { flex: none; width: 40rpx; font-size: 26rpx; line-height: 38rpx; color: #B8860B; font-weight: 700; }
.tip-text {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: #74766F;
  line-height: 38rpx;
}

/* ── 底部返回 ── */
.back-link {
  text-align: right;
  padding: 30rpx 40rpx 50rpx;
  font-size: 23rpx;
  color: #8F9670;
  line-height: 32rpx;
}
