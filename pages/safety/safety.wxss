.scroll { height: calc(100vh - 141.85rpx); }.section { box-sizing: border-box; width: 673.08rpx; margin: 32rpx auto; padding: 34.62rpx; background: #FDFBF6; border-radius: 30.77rpx; box-shadow: 0 3.85rpx 15.38rpx rgba(79,69,51,.08); }.section-title, .section-intro, .block-title, .block-body { display: block; }.section-title { font-size: 40.38rpx; font-weight: 700; line-height: 57.69rpx; margin: 0; padding: 0; }.section-intro { margin-top: 8rpx; color: #74766F; font-size: 25rpx; line-height: 46.15rpx; }.content-block { margin-top: 60rpx; }.section-intro + .content-block { margin-top: 38rpx; }.block-title { font-size: 30.77rpx; font-weight: 700; line-height: 46.15rpx; }.block-item { display: block; margin-top: 10rpx; font-size: 25rpx; line-height: 38.46rpx; }.olive { color: #8F9670; }.danger { color: #C49A52; }.back-directory { display: flex; height: 61.54rpx; margin-top: 23.08rpx; align-items: center; justify-content: flex-end; color: #8F9670; font-size: 23.08rpx; line-height: 32.69rpx; }
