<view class="page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;">
    
    
  </view>
  <view class="topbar">
    <view class="back-hit" bindtap="goBack"><text class="back-icon">‹</text></view>
    <text class="topbar-title">科技助农</text>
    
  </view>

  <view class="content">
    <text class="page-title">科创兴农 · 双基地产业助农</text>
    <text class="page-subtitle">菌菇全流程培育展示</text>

    <view class="mode-card" bindtap="goFarmingDetail1">
      <view class="accent accent-gold"></view>
      <text class="card-location">机场新村</text>
      <text class="card-title">全绿色无添加种植模式</text>
      <text class="card-desc">天然培养基、零化学添加、生态大棚发菌、废菌棒堆肥返田，构建绿色循环生态闭环。</text>
      <text class="card-tags tags-gold">天然基料 · 物理控温 · 绿色循环</text>
      <text class="card-link link-gold">查看完整六步种植流程  →</text>
    </view>

    <view class="mode-card second-card" bindtap="goFarmingDetail2">
      <view class="accent accent-green"></view>
      <text class="card-location">怀远泽康基地</text>
      <text class="card-title">智能化温控标准化种植模式</text>
      <text class="card-desc">中科院优选菌种、自动化无菌接种、智慧菌仓恒温培育、冷链直供，实现标准化生产。</text>
      <text class="card-tags tags-green">AI精准控温 · 5天周期 · 极速锁鲜</text>
      <text class="card-link link-green">查看完整六步种植流程  →</text>
    </view>

    <view class="shop-button" bindtap="goShop">
      <image class="shop-hit-art" src="/images/farming-shop-hit.svg" mode="fill" />
      <text class="shop-button-text">菌菇售卖收益分配  →</text>
    </view>
  </view>
</view>
