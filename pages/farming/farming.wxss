/* .page / .status-bar / .topbar / .back-hit / .back-icon / .topbar-title / .topbar-menu 已在 app.wxss 定义 */
.page { padding-bottom: 78.85rpx; }
/* .status-bar min-height:38px 已在 app.wxss 定义 */
.status-time, .status-signal { position: absolute; top: 14px; line-height: 1; }.status-time { left: 46.15rpx; }.status-signal { right: 36.54rpx; color: #373A35; font-size: 19.23rpx; }
.content { padding: 0 36.54rpx; }.page-title, .page-subtitle, .card-location, .card-title, .card-desc, .card-tags, .card-link { display: block; }
.page-title { margin-top: 5.77rpx; font-size: 46.15rpx; font-weight: 700; line-height: 69.23rpx; }.page-subtitle { margin-top: 0; color: #74766F; font-size: 23.08rpx; line-height: 34.62rpx; }
.mode-card { position: relative; box-sizing: border-box; height: 473.08rpx; margin-top: 61.54rpx; padding: 36.54rpx 44.23rpx; overflow: hidden; border: 1px solid #E5DED1; border-radius: 30.77rpx; background: #FDFBF6; box-shadow: 0 5.77rpx 19.23rpx rgba(56,59,54,.07); }
.second-card { margin-top: 38.46rpx; }.accent { position: absolute; left: -1.92rpx; top: 28.85rpx; width: 11.54rpx; height: 411.54rpx; border-radius: 5.77rpx; }.accent-gold { background: #C49A52; }.accent-green { background: #8F9670; }
.card-location { height: 38.46rpx; color: #74766F; font-size: 21.15rpx; font-weight: 500; line-height: 38.46rpx; }.card-title { height: 38.46rpx; margin-top: 15.38rpx; font-size: 36.54rpx; font-weight: 700; line-height: 38.46rpx; }
.card-desc { width: 576.92rpx; margin-top: 30.77rpx; color: #74766F; font-size: 23.08rpx; line-height: 38.46rpx; }.card-tags { height: 38.46rpx; margin-top: 51.92rpx; font-size: 21.15rpx; font-weight: 500; line-height: 38.46rpx; }.tags-gold, .link-gold { color: #C49A52; }.tags-green, .link-green { color: #8F9670; }
.card-link { height: 38.46rpx; margin-top: 51.92rpx; font-size: 23.08rpx; font-weight: 500; line-height: 38.46rpx; }
.shop-button { position: relative; display: flex; box-sizing: border-box; height: 100rpx; margin-top: 123.08rpx; align-items: center; justify-content: center; overflow: hidden; border-radius: 23.08rpx; background: #C3655B; box-shadow: 0 3.85rpx 15.38rpx rgba(79,69,51,.08); }.shop-hit-art { position: absolute; inset: 0; width: 100%; height: 100%; }.shop-button-text { position: relative; z-index: 1; color: #FDFBF6; font-size: 30.77rpx; font-weight: 700; line-height: 48.08rpx; }
