/* 首页页面级样式：米色 + 青铜金主题 */

.page {
  padding: 0 32rpx 32rpx;
  background: #F5F0E8;
  min-height: 100vh;
}

/* ================= 独立白底顶部标题栏 ================= */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  z-index: 999;
}

.header-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  position: relative;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2C2416;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.header-placeholder {
  width: 88rpx;
  height: 64rpx;
}

.header-spacer {
  width: 100%;
  background: #FFFFFF;
}

/* ================= 顶部 Hero 区 ================= */
.hero {
  position: relative;
  width: 100%;
  height: 420rpx;
  border-radius: 28rpx;
  overflow: hidden;
  margin-top: 40rpx;
  margin-bottom: 56rpx;
  background: linear-gradient(180deg, #2B2318 0%, #4A3B2A 40%, #6B5438 100%);
}

.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-overlay {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  padding: 60rpx 40rpx 10rpx;
  display: flex;
  flex-direction: column;
}

.hero-tag {
  font-size: 30rpx;
  font-weight: bold;
  color: rgba(255,255,255,0.9);
  letter-spacing: 2rpx;
  margin-bottom: 32rpx;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.3);
}

.hero-title {
  font-size: 50rpx;
  font-weight: bold;
  color: #FFFFFF;
  line-height: 1.35;
  margin-bottom: 32rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4);
}

.hero-title-line {
  line-height: 1.35;
}

.hero-btn {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  background: transparent;
  border: none;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  padding: 0;
  letter-spacing: 2rpx;
  margin-top: 20rpx;
}

.hero-btn-arrow {
  margin-left: 12rpx;
  font-size: 34rpx;
}


/* ================= 四大主题标题 ================= */
.section-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #2C2416;
  margin-bottom: 32rpx;
  padding-left: 4rpx;
}

/* ================= 2×2 卡片网格 ================= */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-item {
  width: 48.5%;
  margin-bottom: 24rpx;
  padding: 40rpx 32rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 109, 53, 0.06);
  transition: transform 0.2s, box-shadow 0.2s;
}

/* 按下反馈 */
.grid-item-active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 10rpx rgba(139, 109, 53, 0.1);
}

/* 青铜金编号方块（带圆角正方形） */
.card-number {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #B8860B 0%, #8B6914 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  letter-spacing: 1rpx;
}

/* 卡片标题 */
.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2C2416;
  margin-bottom: 14rpx;
  line-height: 1.3;
}

/* 卡片描述 */
.card-desc {
  font-size: 24rpx;
  color: #A89B8C;
  line-height: 1.5;
}