<!-- 首页：皖北珍菌 -->
<view class="page">

  <!-- 独立白底顶部标题栏（fixed 固定在顶部） -->
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-inner">
      <view class="header-placeholder"></view>
      <view class="header-title">皖北珍菌</view>
      <view class="header-placeholder"></view>
    </view>
  </view>

  <!-- 占位：避开固定 header 高度（精确计算） -->
  <view class="header-spacer" style="height: {{headerHeight}}px;"></view>

  <!-- 顶部 Hero 区：菌菇图片 + 文字叠层 -->
  <view class="hero">
    <image class="hero-image" src="{{heroImage}}" mode="aspectFill"></image>
    <view class="hero-overlay">
      <view class="hero-tag">乡野新生 · 科创兴农</view>
      <view class="hero-title">
        <view class="hero-title-line">一朵菌菇，长出</view>
        <view class="hero-title-line">皖北乡村新未来</view>
      </view>
      <view class="hero-btn" bindtap="onExploreTap">
        <text>开始探索</text>
        <text class="hero-btn-arrow">→</text>
      </view>
    </view>
  </view>

  <!-- 四大主题 -->
  <view class="section-title">四大主题</view>
  <view class="grid">
    <view
      wx:for="{{cards}}"
      wx:key="title"
      class="grid-item"
      hover-class="grid-item-active"
      data-index="{{index}}"
      bindtap="onCardTap"
    >
      <view class="card-number">{{item.number}}</view>
      <view class="card-title">{{item.title}}</view>
      <view class="card-desc">{{item.desc}}</view>
    </view>
  </view>

</view>