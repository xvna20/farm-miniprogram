/* .page / .status-bar / .topbar / .back-hit / .back-icon / .topbar-title / .topbar-menu 已在 app.wxss 定义 */
.status-time, .status-signal { position: absolute; top: 14px; line-height: 1; }.status-time { left: 46.15rpx; }.status-signal { right: 36.54rpx; color: #373A35; font-size: 19.23rpx; }
.scroll { height: calc(100vh - 141.85rpx); }
.section { box-sizing: border-box; width: 673.08rpx; margin: 32rpx auto 0; padding: 34.62rpx; background: #FDFBF6; border-radius: 30.77rpx; box-shadow: 0 3.85rpx 15.38rpx rgba(79,69,51,.08); }
.section-title, .section-intro { display: block; }
.section-title { font-size: 40.38rpx; font-weight: 700; line-height: 57.69rpx; }
.section-intro { margin-top: 23rpx; color: #74766F; font-size: 25rpx; line-height: 46.15rpx; }
.season-card { display: flex; align-items: flex-start; width: 673.08rpx; margin: 24rpx auto 0; box-sizing: border-box; padding: 34.62rpx; border-radius: 30.77rpx; }
.season-badge { flex: none; width: 76.92rpx; height: 76.92rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 30.77rpx; font-weight: 700; color: #FDFBF6; }
.season-info { flex: 1; min-width: 0; margin-left: 26.92rpx; }
.season-name { display: block; font-size: 30.77rpx; font-weight: 700; line-height: 46.15rpx; }
.season-desc { display: block; margin-top: 16rpx; font-size: 25rpx; line-height: 38.46rpx; color: #74766F; }
.spring { background: #EFF1E4; }.spring .season-badge { background: #8F9670; }.spring .season-name { color: #373A35; }
.summer { background: #F7EFDC; }.summer .season-badge { background: #C49A52; }.summer .season-name { color: #373A35; }
.autumn { background: #F4EADD; }.autumn .season-badge { background: #B07B4F; }.autumn .season-name { color: #373A35; }
.winter { background: #EAEFF2; }.winter .season-badge { background: #8296A5; }.winter .season-name { color: #373A35; }
.back-directory { display: flex; height: 61.54rpx; margin-top: 23.08rpx; align-items: center; justify-content: flex-end; color: #8F9670; font-size: 23.08rpx; line-height: 32.69rpx; }
