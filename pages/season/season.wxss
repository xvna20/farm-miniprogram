/* .page / .status-bar / .topbar / .back-hit / .back-icon / .topbar-title / .topbar-menu 已在 app.wxss 定义 */
.status-time, .status-signal { position: absolute; top: 14px; line-height: 1; }.status-time { left: 46.15rpx; }.status-signal { right: 36.54rpx; color: #373A35; font-size: 19.23rpx; }
.topbar { position: relative; height: 103.85rpx; display: flex; align-items: center; justify-content: center; background: #FDFBF6; }.back-hit { position: absolute; left: 0; top: 0; display: flex; width: 107.69rpx; height: 103.85rpx; align-items: center; }.back-icon { margin-left: 34.62rpx; margin-top: -7.69rpx; font-size: 65.38rpx; line-height: 1; }.topbar-title { font-size: 32.69rpx; font-weight: 700; line-height: 46.15rpx; }.topbar-menu { position: absolute; right: 26.92rpx; top: 13.46rpx; font-size: 34.62rpx; font-weight: 700; line-height: 53.85rpx; letter-spacing: 7.69rpx; }
.scroll { height: calc(100vh - 141.85rpx); }.section { box-sizing: border-box; width: 673.08rpx; margin: 32rpx auto; padding: 34.62rpx; background: #FDFBF6; border-radius: 30.77rpx; box-shadow: 0 3.85rpx 15.38rpx rgba(79,69,51,.08); }.section-title, .section-intro, .season-title, .season-body { display: block; }.section-title { font-size: 40.38rpx; font-weight: 700; line-height: 57.69rpx; }.section-intro { margin-top: 23rpx; color: #74766F; font-size: 25rpx; line-height: 46.15rpx; }.season-block { margin-top: 100rpx; }.section-intro + .season-block { margin-top: 38rpx; }.season-title { font-size: 30.77rpx; font-weight: 700; line-height: 46.15rpx; }.season-body { margin-top: 23rpx; font-size: 25rpx; line-height: 38.46rpx; }.olive { color: #8F9670; }.honey { color: #C49A52; }.back-directory { display: flex; height: 61.54rpx; margin-top: 23.08rpx; align-items: center; justify-content: flex-end; color: #8F9670; font-size: 23.08rpx; line-height: 32.69rpx; }
