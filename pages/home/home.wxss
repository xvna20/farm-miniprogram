.page {
  min-height: 100vh;
  background-color: #F6F1E7;
  padding-bottom: 144rpx;
}

/* 自定义导航栏 */
.nav-status {
  width: 100%;
  background-color: #F6F1E7;
}

.nav-bar {
  width: 100%;
  height: 104rpx;
  background-color: #FDFBF6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #373A35;
}
.dots{position:absolute;right:28rpx;top:22rpx;font-size:28rpx;letter-spacing:8rpx}

/* 英雄横幅 */
.hero {
  position: relative;
  width: 690rpx;
  height: 368rpx;
  border-radius: 42rpx;
  overflow: hidden;
  margin: 32rpx 30rpx 54rpx;
}

.hero-bg {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  background-color: #2a2a2a;
}

.hero-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(55, 58, 53, 0.72);
}

.hero-content {
  position: absolute;
  bottom: 20rpx;
  left: 0;
  right: 0;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
}

.hero-tag {
  font-size: 25rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 16rpx;
}

.hero-title-wrap {
  margin-bottom: 32rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: bold;
  color: #F6F1E7;
  line-height: 1.1;
  margin-bottom: 13rpx;
  text-align: left;
}

.hero-btn {
  display: inline-flex;
  align-items: center;
  font-size: 28rpx;
  color: #F6F1E7;
}

/* 四大主题 */
.section {
  padding: 0 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 31rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #373A35;
}

.section-more {
  font-size: 26rpx;
  color: #C49A52;
}

.theme-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 23rpx;
}

.theme-card {
  background-color: #FDFBF6;
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  height: 276rpx;
  box-shadow: 0 4rpx 16rpx rgba(79,69,51,.08);
}

.badge {
  width: 84rpx;
  height: 84rpx;
  background-color: #C49A52;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #373A35;
  margin-bottom: 6rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #74766F;
}


